{
	"schemaVersion": 1,
	"id": "autominer",
	"version": "${version}",
	"name": "Auto Miner",
	"description": "A client-side Fabric mod for automatic tunnel mining, ore priority and configurable navigation.",
	"authors": [
		"Jason54jg"
	],
	"contact": {
		"sources": "https://github.com/jason54jg/miningmod",
		"homepage": "https://jason54jg.github.io/MiningMod/",
		"issues": "https://github.com/Jason54jg/MiningMod/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotlin",
				"value": "com.jason54jg.autominer.AutoMinerMod"
			}
		],
		"client": [
			{
				"adapter": "kotlin",
				"value": "com.jason54jg.autominer.client.AutoMinerModClient"
			}
		],
		"modmenu": [
			{
				"adapter": "kotlin",
				"value": "com.jason54jg.autominer.client.AutoMinerModMenuIntegration"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"icon": "assets/autominer/textures/logo.png"
}
